{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build compiler",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-g",
                "${workspaceFolder}/main.c",
                "${workspaceFolder}/Tokens/token.c",
                "${workspaceFolder}/Tokens/tokenList.c",
                "-o",
                "${workspaceFolder}/mycompiler.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Task to build the C compiler with debugging symbols"
        }
    ]
}